local function loadFishList()
    for _, v in pairs(DropdownList:GetChildren()) do
        if v:IsA("TextButton") then v:Destroy() end
    end

    StatusLabel.Text = "Status: Fetching Fish..."
    DropdownBtn.Text = "Loading..."
    
    local success, data = pcall(function() return GetPlayerData:InvokeServer() end)
    
    if success and type(data) == "table" and data.unlockedFish then
        local count = 0
        for fishId, isUnlocked in pairs(data.unlockedFish) do
            if isUnlocked == true then
                count = count + 1
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, -10, 0, 35)
                btn.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
                btn.Text = "🐟 " .. fishId
                btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                btn.Font = Enum.Font.GothamBold
                btn.TextSize = 16 
                btn.ZIndex = 10
                btn.Parent = DropdownList
                Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
                
                btn.MouseButton1Click:Connect(function()
                    selectedFishId = fishId
                    DropdownBtn.Text = "🐟 " .. fishId
                    DropdownList.Visible = false
                    StatusLabel.Text = "Selected: " .. fishId
                end)
            end
        end
        
        DropdownList.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 5)
        DropdownBtn.Text = "🐟 Fishes (" .. count .. ")"
        StatusLabel.Text = "Status: Loaded " .. count .. " fish!"
    else
        DropdownBtn.Text = "Failed to load."
        StatusLabel.Text = "Status: Check console."
    end
end

