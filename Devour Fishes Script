local function findBestFood()
    local bestFood = nil
    local highestPriority = -1
    local shortestDist = math.huge
    
    local myModel = workspace:FindFirstChild(LocalPlayer.Name)
    local myPos = myModel and myModel:GetPivot().Position or Vector3.new(0,0,0)

    local function checkObject(obj)
        local priority = FoodPriority[obj.Name]
        if priority then
            local targetPos = nil
            if obj:IsA("BasePart") then
                targetPos = obj.Position
            elseif obj:IsA("Model") then
                if obj.PrimaryPart then
                    targetPos = obj.PrimaryPart.Position
                else
                    local s, p = pcall(function() return obj:GetPivot().Position end)
                    if s then targetPos = p end
                end
            end
            
            if targetPos then
                local dist = (myPos - targetPos).Magnitude
                if priority > highestPriority then
                    highestPriority = priority
                    shortestDist = dist
                    bestFood = obj
                elseif priority == highestPriority and dist < shortestDist then
                    shortestDist = dist
                    bestFood = obj
                end
            end
        end
    end

    local liveFood = workspace:FindFirstChild("LiveFood")
    if liveFood then
        for _, v in pairs(liveFood:GetDescendants()) do checkObject(v) end
    end
    
    for _, v in pairs(workspace:GetDescendants()) do 
        if not liveFood or not v:IsDescendantOf(liveFood) then
            checkObject(v) 
        end
    end
    
    return bestFood
end

local function simulateClick(foodPos)
    pcall(function()
        local camera = workspace.CurrentCamera
        local screenPos, onScreen = camera:WorldToViewportPoint(foodPos)
        
        local char = LocalPlayer.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if not tool and LocalPlayer:FindFirstChild("Backpack") then
                tool = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                if tool then
                    tool.Parent = char
                end
            end
            if tool then
                tool:Activate()
            end
        end

        if onScreen and VirtualUser then
            VirtualUser:CaptureController()
            VirtualUser:ClickButton1(Vector2.new(screenPos.X, screenPos.Y))
        elseif mouse1click then
            mouse1click()
        end
    end)
end

RunService.Stepped:Connect(function()
    if isFarming then
        setNoclip(true)
        
        if currentTarget and currentTarget.Parent then
            local myModel = workspace:FindFirstChild(LocalPlayer.Name)
            
            local foodPos
            if currentTarget:IsA("BasePart") then
                foodPos = currentTarget.Position
            elseif currentTarget:IsA("Model") then
                foodPos = currentTarget.PrimaryPart and currentTarget.PrimaryPart.Position or currentTarget:GetPivot().Position
            end
            
            if myModel and foodPos then
                local myPos = myModel:GetPivot().Position
                
                local myFlat = Vector3.new(myPos.X, 0, myPos.Z)
                local foodFlat = Vector3.new(foodPos.X, 0, foodPos.Z)
                local horizDist = (myFlat - foodFlat).Magnitude
                
                local extents = myModel:GetExtentsSize()
                local stopDistance = math.max(5, extents.Magnitude / 2)
                local distToFood = (myPos - foodPos).Magnitude
                
                local targetY = foodPos.Y
                
                if horizDist > 15 then
                    targetY = foodPos.Y - 50
                end
                
                local finalTarget = Vector3.new(foodPos.X, targetY, foodPos.Z)
                
                if horizDist > 15 or distToFood > stopDistance then
                    local moveDir = (finalTarget - myPos).Unit
                    pcall(function()
                        myModel:TranslateBy(moveDir * 8)
                    end)
                    
                    if horizDist > 15 then
                        StatusLabel.Text = string.format("Traveling under map to %s", currentTarget.Name)
                    else
                        StatusLabel.Text = string.format("Rising to %s", currentTarget.Name)
                    end
                else
                    if tick() - lastBiteTime > 0.25 then
                        lastBiteTime = tick()
                        StatusLabel.Text = "Biting " .. currentTarget.Name
                        
                        local realDist = (myPos - foodPos).Magnitude
                        
                        pcall(function()
                            BiteFood:FireServer(currentTarget, realDist, true)
                            if BiteCreature then BiteCreature:FireServer(currentTarget) end
                        end)
                        
                        task.spawn(function()
                            simulateClick(foodPos)
                        end)
                        
                        if firesignal then
                            pcall(firesignal, GiveFood.OnClientEvent, 0.5, "bite")
                            pcall(firesignal, GainXP.OnClientEvent, 30)
                            pcall(firesignal, StatusHit.OnClientEvent)
                        end
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while task.wait(0.5) do
        if isFarming then
            if not currentTarget or not currentTarget.Parent then
                currentTarget = findBestFood()
                if currentTarget then
                    if currentHighlight then currentHighlight:Destroy() end
                    currentHighlight = Instance.new("Highlight")
                    currentHighlight.FillColor = Color3.fromRGB(255, 0, 0)
                    currentHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    currentHighlight.Parent = currentTarget
                else
                    StatusLabel.Text = "Searching for food..."
                end
            end
        else
            currentTarget = nil
            if currentHighlight then 
                currentHighlight:Destroy() 
                currentHighlight = nil
            end
        end
    end
end)

