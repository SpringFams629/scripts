-- ==========================================
-- 6. HYPER-FAST TARGETING & BITING LOOP
-- ==========================================
local currentTarget = nil
local idleTime = 0

-- Helper to find the best food on the map
local function findBestFood()
    local bestFood = nil
    local highestPriority = -1
    local shortestDist = math.huge
    
    local myChar = LocalPlayer.Character or workspace:FindFirstChild(LocalPlayer.Name)
    local myPos = myChar and myChar:FindFirstChild("HumanoidRootPart") and myChar.HumanoidRootPart.Position or Vector3.new(0,0,0)

    local function checkObject(obj)
        local priority = FoodPriority[obj.Name]
        if priority then
            local targetPos = nil
            if obj:IsA("Model") then
                targetPos = obj.PrimaryPart and obj.PrimaryPart.Position or obj:GetPivot().Position
            elseif obj:IsA("BasePart") then
                targetPos = obj.Position
            end
            
            if targetPos then
                local dist = (myPos - targetPos).Magnitude
                if priority > highestPriority then
                    highestPriority = priority
                    shortestDist = dist
                    bestFood = obj
                elseif priority == highestPriority and dist < shortestDist then
                    shortestDist = dist
                    bestFood = obj
                end
            end
        end
    end

    for _, v in pairs(workspace:GetDescendants()) do checkObject(v) end
    if getnilinstances then
        local s, instances = pcall(getnilinstances)
        if s and instances then for _, v in pairs(instances) do checkObject(v) end end
    end
    return bestFood
end

task.spawn(function()
    -- task.wait() without numbers runs as fast as the game frame rate (approx 60fps)
    while task.wait() do
        if isFarming then
            -- If we don't have a target, or the target was destroyed/eaten, find a new one
            if not currentTarget or not currentTarget.Parent then
                currentTarget = findBestFood()
                if currentTarget then
                    StatusLabel.Text = "Status: Eating " .. currentTarget.Name
                end
            end

            if currentTarget then
                idleTime = 0
                -- Spam bite the SAME target until it disappears
                pcall(function()
                    BiteFood:FireServer(currentTarget, 3.07, true)
                    UpdateGrowth:FireServer(50000, 0) 
                end)
                if firesignal then
                    pcall(firesignal, GiveFood.OnClientEvent, 0.5, "bite")
                    pcall(firesignal, GainXP.OnClientEvent, 30)
                    pcall(firesignal, StatusHit.OnClientEvent)
                end
            else
                idleTime = idleTime + (1/60) -- roughly 0.016 per frame
                StatusLabel.Text = string.format("Status: No food. Refreshing in %.1fs...", math.max(0, 3 - idleTime))
                if idleTime >= 3 then
                    StatusLabel.Text = "Status: Refreshing Fish..."
                    refreshFish()
                    idleTime = 0
                    task.wait(1)
                end
            end
        end
    end
end)

